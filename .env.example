# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token for OmniStream bot.
# Configure securely via the Secrets panel in AI Studio or .env
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# TELEGRAM_API_ID and TELEGRAM_API_HASH (Optional for Pyrogram 2GB video uploads):
# Obtained from https://my.telegram.org. If omitted, official Telegram defaults are used.
# TELEGRAM_API_ID=2040
# TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627
